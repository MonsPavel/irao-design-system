{
  "name": "irao-ui",
  "version": "0.1.0",
  "private": true,
  "description": "irao-ui — UI-система для сайтов группы на Bitrix: нативный CSS/JS, БЭМ ui-, токены --ui-* (docs/02-architecture.md).",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "lint": "npm run lint:css && npm run lint:js && npm run lint:format && npm run lint:html",
    "lint:css": "stylelint \"**/*.css\" \"!dist/**\" \"!tests/lint-cases/**\" --allow-empty-input",
    "lint:js": "eslint .",
    "lint:format": "prettier --check .",
    "lint:html": "node tools/lint-html.mjs",
    "test": "echo \"[заглушка] test появится в T1.4/T1.6: Playwright e2e + axe, Vitest unit\"",
    "test:lint": "node tools/run-lint-cases.mjs",
    "test:unit": "vitest run",
    "build": "node showcase/build.mjs",
    "serve": "node showcase/serve.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "html-validate": "^11.16.2",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.9",
    "stylelint": "^17.16.0",
    "stylelint-declaration-strict-value": "^1.12.1",
    "stylelint-order": "^8.1.1",
    "stylelint-selector-bem-pattern": "^5.0.0",
    "vitest": "^5.0.3"
  }
}
